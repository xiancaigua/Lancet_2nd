# Lancet email notification configuration

# Keep disabled until credentials are filled and a later explicit test succeeds.
LANCET_EMAIL_ENABLED=false

# SMTP server, for example smtp.gmail.com.
LANCET_SMTP_HOST=

# Common ports: 587 for STARTTLS, 465 for direct SSL.
LANCET_SMTP_PORT=

# Sender SMTP account, usually the complete email address.
LANCET_SMTP_USER=

# SMTP password or provider-issued App Password; usually not the login password.
LANCET_SMTP_PASSWORD=

# Sender address, normally the same as LANCET_SMTP_USER.
LANCET_EMAIL_FROM=

# Address that receives Lancet experiment notifications.
LANCET_EMAIL_TO=

# Usually enable exactly one of STARTTLS and SSL.
LANCET_SMTP_STARTTLS=true
LANCET_SMTP_SSL=false
